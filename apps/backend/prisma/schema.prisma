// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum QuackMood {
  happy
  sad
  angry
  silly

  @@map("quack_mood")
}

model Quack {
  id        String     @id @default(cuid())
  text      String     @db.Text
  mood      QuackMood?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  // Set when the quack is deleted, by its author or by an admin. The row
  // stays, and so do its poll and votes, because no cascade fires;
  // QuackRepository skips it on every read. Who deleted it and why is in
  // QuackDeletion, written in the same transaction.
  deletedAt DateTime?
  deletion  QuackDeletion?
  // A quack without a poll is a plain post — the common case.
  poll      Poll?

  @@index([userId])
  // The feed: quacks that are not deleted, newest first.
  @@index([deletedAt, createdAt(sort: Desc)])
  @@map("quack")
}

// The record behind Quack.deletedAt: who deleted the quack, when and why.
// Quack.deletedAt stays the flag every read filters on (and the feed index
// covers); this row is what a future overview of deleted quacks reads. At
// most one per quack, so the quack's id is the primary key.
model QuackDeletion {
  quack       Quack    @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId     String   @id
  // The author for their own quack, otherwise the admin who removed it.
  deletedBy   User     @relation(fields: [deletedById], references: [id], onDelete: Cascade)
  deletedById String
  // Required from an admin, absent when an author deletes their own quack.
  // Shown to nobody in the app for now.
  reason      String?  @db.VarChar(500)
  // The same instant as Quack.deletedAt, so the record stands on its own.
  createdAt   DateTime @default(now())

  @@index([deletedById])
  @@map("quack_deletion")
}

// Satellite of a quack: the quack's text is the question, so the poll itself
// only owns the options and the votes. Anything a poll might grow later
// (closing time, multiple choice) belongs here, not on Quack.
model Poll {
  id        String       @id @default(cuid())
  quack     Quack        @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId   String       @unique
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     PollVote[]

  @@map("poll")
}

model PollOption {
  id       String     @id @default(cuid())
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  text     String     @db.VarChar(50)
  // 0-based order in which the author entered the options.
  position Int
  votes    PollVote[]

  // Target of the composite foreign key from PollVote, so a vote can only
  // point at an option of its own poll.
  @@unique([pollId, id])
  @@unique([pollId, position])
  @@map("poll_option")
}

model PollVote {
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  // Redundant with option.pollId on purpose: "one vote per poll" needs the
  // poll in the primary key, and the composite FK below keeps it honest.
  pollId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  option    PollOption @relation(fields: [pollId, optionId], references: [pollId, id], onDelete: Cascade)
  optionId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  @@id([pollId, userId])
  @@index([optionId])
  @@map("poll_vote")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?   @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  quacks         Quack[]
  pollVotes      PollVote[]
  quackDeletions QuackDeletion[]
  role          UserRole  @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  // Profile settings edited on the Settings page. BetterAuth owns the columns
  // above; these belong to the app. The mood reuses the quack enum so the
  // default and the post can never disagree.
  bio         String?    @db.VarChar(160)
  defaultMood QuackMood?

  @@unique([email])
  @@unique([username])
  @@map("user")
}
