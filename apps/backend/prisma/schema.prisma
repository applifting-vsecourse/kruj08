// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum QuackMood {
  happy
  sad
  angry
  silly

  @@map("quack_mood")
}

model Quack {
  id        String     @id @default(cuid())
  text      String     @db.Text
  mood      QuackMood?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  // A quack without a poll is a plain post — the common case.
  poll      Poll?

  @@index([userId])
  @@map("quack")
}

// Satellite of a quack: the quack's text is the question, so the poll itself
// only owns the options and the votes. Anything a poll might grow later
// (closing time, multiple choice) belongs here, not on Quack.
model Poll {
  id        String       @id @default(cuid())
  quack     Quack        @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId   String       @unique
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     PollVote[]

  @@map("poll")
}

model PollOption {
  id       String     @id @default(cuid())
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  text     String     @db.VarChar(50)
  // 0-based order in which the author entered the options.
  position Int
  votes    PollVote[]

  // Target of the composite foreign key from PollVote, so a vote can only
  // point at an option of its own poll.
  @@unique([pollId, id])
  @@unique([pollId, position])
  @@map("poll_option")
}

model PollVote {
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  // Redundant with option.pollId on purpose: "one vote per poll" needs the
  // poll in the primary key, and the composite FK below keeps it honest.
  pollId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  option    PollOption @relation(fields: [pollId, optionId], references: [pollId, id], onDelete: Cascade)
  optionId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  @@id([pollId, userId])
  @@index([optionId])
  @@map("poll_vote")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?   @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  quacks        Quack[]
  pollVotes     PollVote[]
  role          UserRole  @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  // Profile settings edited on the Settings page. BetterAuth owns the columns
  // above; these belong to the app. The mood reuses the quack enum so the
  // default and the post can never disagree.
  bio         String?    @db.VarChar(160)
  defaultMood QuackMood?

  @@unique([email])
  @@unique([username])
  @@map("user")
}
